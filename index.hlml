<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mines Prediction Tool</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  font-family: Arial, sans-serif;
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  overflow-x: hidden;
  background: linear-gradient(-45deg, #06111f, #101b35, #071d25, #160d2c);
  background-size: 400% 400%;
  animation: backgroundMove 15s ease infinite;
}

@keyframes backgroundMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

body::before,
body::after {
  content: "";
  position: fixed;
  width: 350px;
  height: 350px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: .25;
  z-index: -1;
}

body::before {
  background: #00eaff;
  top: -100px;
  left: -100px;
}

body::after {
  background: #8b00ff;
  right: -100px;
  bottom: -100px;
}

.container {
  width: 100%;
  max-width: 560px;
  padding: 28px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 25px;
  background: rgba(255,255,255,.08);
  backdrop-filter: blur(18px);
  box-shadow: 0 20px 70px rgba(0,0,0,.45);
}

header {
  text-align: center;
  margin-bottom: 25px;
}

header h1 {
  font-size: 30px;
  margin-bottom: 8px;
  background: linear-gradient(90deg, #00eaff, #7cffcb);
  -webkit-background-clip: text;
  color: transparent;
}

.platform-title {
  font-size: 15px;
  color: #aaa;
}

.platform-title span {
  color: #00eaff;
  font-weight: bold;
}

.controls {
  display: grid;
  gap: 15px;
  margin-bottom: 22px;
}

label {
  font-size: 14px;
  color: #c9d3df;
  margin-bottom: 6px;
  display: block;
}

select,
input {
  width: 100%;
  padding: 14px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 12px;
  outline: none;
  color: #fff;
  background: rgba(0,0,0,.3);
  transition: .25s;
}

select:focus,
input:focus {
  border-color: #00eaff;
  box-shadow: 0 0 15px rgba(0,234,255,.2);
}

select option {
  background: #101827;
}

.buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

button {
  border: 0;
  padding: 14px;
  border-radius: 12px;
  color: #fff;
  font-weight: bold;
  cursor: pointer;
  transition: transform .2s, box-shadow .2s;
}

button:hover {
  transform: translateY(-3px);
}

.predict {
  background: linear-gradient(135deg, #00c853, #00e5a8);
  box-shadow: 0 8px 25px rgba(0,200,83,.25);
}

.reset {
  background: linear-gradient(135deg, #37474f, #546e7a);
}

button:active {
  transform: scale(.96);
}

.grid {
  width: min(100%, 430px);
  aspect-ratio: 1;
  margin: 25px auto;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
}

.tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.1);
  background: rgba(255,255,255,.07);
  font-size: clamp(22px, 7vw, 34px);
  cursor: pointer;
  opacity: .85;
  transition: transform .25s, box-shadow .35s, background .35s;
}

.tile:hover {
  transform: scale(1.05);
  background: rgba(255,255,255,.13);
}

.tile.safe {
  background: rgba(0, 255, 120, .15);
  border-color: #00ff88;
  box-shadow:
    0 0 10px rgba(0,255,120,.8),
    0 0 25px rgba(0,255,120,.45);
  animation: safePop .5s ease forwards, safeGlow 1.6s infinite alternate;
}

.tile.mine {
  background: rgba(255,40,70,.13);
  border-color: #ff405c;
  box-shadow:
    0 0 10px rgba(255,40,70,.7),
    0 0 20px rgba(255,40,70,.35);
  animation: minePop .45s ease forwards;
}

@keyframes safePop {
  0% {
    opacity: 0;
    transform: scale(.4);
  }
  70% {
    transform: scale(1.12);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes minePop {
  0% {
    opacity: 0;
    transform: scale(.5);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes safeGlow {
  from {
    box-shadow: 0 0 8px #00ff88;
  }
  to {
    box-shadow: 0 0 25px #00ff88, 0 0 40px rgba(0,255,120,.3);
  }
}

.join {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 10px;
}

.join a {
  text-decoration: none;
  color: white;
  padding: 13px;
  text-align: center;
  border-radius: 12px;
  font-weight: bold;
  transition: .25s;
}

.telegram {
  background: linear-gradient(135deg, #0088cc, #00bfff);
}

.youtube {
  background: linear-gradient(135deg, #ff0000, #ff5252);
}

.join a:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 10px 25px rgba(0,0,0,.3);
}

.status {
  text-align: center;
  min-height: 22px;
  font-size: 13px;
  color: #aeb8c5;
}

footer {
  text-align: center;
  margin-top: 22px;
  color: #778494;
  font-size: 12px;
}

.theme {
  position: absolute;
  top: 15px;
  right: 15px;
  width: auto;
  padding: 9px 12px;
  border-radius: 50%;
  background: rgba(255,255,255,.1);
}

.light {
  background: linear-gradient(-45deg, #e9f7ff, #f6f0ff, #eafff6, #fff);
  color: #17202a;
}

.light .container {
  background: rgba(255,255,255,.6);
  border-color: rgba(0,0,0,.1);
}

.light input,
.light select {
  color: #111;
  background: rgba(255,255,255,.7);
}

@media (max-width: 500px) {
  body {
    padding: 10px;
  }

  .container {
    padding: 18px;
    border-radius: 20px;
  }

  header h1 {
    font-size: 25px;
  }

  .grid {
    gap: 6px;
  }

  .tile {
    border-radius: 9px;
  }
}
</style>
</head>

<body>

<button class="theme" id="themeBtn">☀️</button>

<main class="container">

  <header>
    <h1>💎 Mines Predictor</h1>
    <div class="platform-title">
      Platform: <span id="platformName">Stake</span>
    </div>
  </header>

  <section class="controls">

    <div>
      <label for="platform">Game Platform</label>
      <select id="platform">
        <option>Stake</option>
        <option>1win</option>
        <option>Tashan Win</option>
        <option>Bet365</option>
      </select>
    </div>

    <div>
      <label for="seed">Enter Your Seeds</label>
      <input
        id="seed"
        type="text"
        placeholder="Enter your seed..."
        autocomplete="off"
      >
    </div>

    <div class="buttons">
      <button class="predict" id="predictBtn">
        🔮 Predict Safe Mines
      </button>

      <button class="reset" id="resetBtn">
        ↻ Reset Game
      </button>
    </div>

  </section>

  <div class="status" id="status">
    Enter a seed and press Predict Safe Mines
  </div>

  <div class="grid" id="grid"></div>

  <div class="join">

    <a
      class="telegram"
      href="https://Zuvora.com
      target="_blank"
      rel="noopener"
    >
      ✈️ Join Telegram
    </a>

    <a
      class="youtube"
      href="https://Zuvora.com/"
      target="_blank"
      rel="noopener"
    >
      ▶️ Join YouTube
    </a>

  </div>

  <footer>
    ⚡ Created by Fun Education
  </footer>

</main>

<script>
const grid = document.getElementById("grid");
const seedInput = document.getElementById("seed");
const predictBtn = document.getElementById("predictBtn");
const resetBtn = document.getElementById("resetBtn");
const platform = document.getElementById("platform");
const platformName = document.getElementById("platformName");
const status = document.getElementById("status");
const themeBtn = document.getElementById("themeBtn");

let tiles = [];

function createGrid() {
  grid.innerHTML = "";
  tiles = [];

  for (let i = 0; i < 25; i++) {
    const tile = document.createElement("div");

    tile.className = "tile";
    tile.dataset.index = i;

    grid.appendChild(tile);
    tiles.push(tile);
  }
}

function hashSeed(seed) {
  let hash = 2166136261;

  for (let i = 0; i < seed.length; i++) {
    hash ^= seed.charCodeAt(i);
    hash +=
      (hash << 1) +
      (hash << 4) +
      (hash << 7) +
      (hash << 8) +
      (hash << 24);

    hash >>>= 0;
  }

  return hash;
}

function seededRandom(seed) {
  let value = hashSeed(seed);

  return function() {
    value += 0x6D2B79F5;

    let t = value;

    t = Math.imul(t ^ t >>> 15, t | 1);
    t ^= t + Math.imul(t ^ t >>> 7, t | 61);

    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

function shuffle(array, random) {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(random() * (i + 1));

    [array[i], array[j]] = [array[j], array[i]];
  }

  return array;
}

function predict() {
  let seed = seedInput.value.trim();

  if (!seed) {
    seed = Math.random().toString(36).slice(2);
    seedInput.value = seed;
  }

  resetGrid(false);

  const random = seededRandom(seed);

  const positions = Array.from(
    { length: 25 },
    (_, index) => index
  );

  shuffle(positions, random);

  const safePositions = positions.slice(0, 5);
  const minePositions = positions.slice(5);

  safePositions.forEach((position, index) => {
    setTimeout(() => {
      const tile = tiles[position];

      tile.classList.add("safe");
      tile.textContent = "💎";
    }, index * 90);
  });

  minePositions.forEach((position, index) => {
    setTimeout(() => {
      const tile = tiles[position];

      tile.classList.add("mine");
      tile.textContent = "💣";
    }, 500 + index * 25);
  });

  status.textContent =
    `Prediction generated for ${platform.value} • 5 safe tiles`;
}

function resetGrid(updateStatus = true) {
  tiles.forEach(tile => {
    tile.className = "tile";
    tile.textContent = "";
  });

  if (updateStatus) {
    status.textContent = "Grid reset. Enter a seed and predict again.";
  }
}

platform.addEventListener("change", () => {
  platformName.textContent = platform.value;
});

predictBtn.addEventListener("click", predict);

resetBtn.addEventListener("click", () => {
  resetGrid();
});

themeBtn.addEventListener("click", () => {
  document.body.classList.toggle("light");

  themeBtn.textContent =
    document.body.classList.contains("light")
      ? "🌙"
      : "☀️";
});

createGrid();
</script>

</body>
</html>
